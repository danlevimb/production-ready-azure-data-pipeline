// Phase 7 — 01 Pipeline runs
// Purpose: Show pipeline-level executions for the MVP pipeline.

AzureDiagnostics
| where TimeGenerated > ago(24h)
| where isnotempty(pipelineName_s)
| where pipelineName_s == "pl_ingest_retail_files_prdp"
| where Category has "Pipeline"
| extend
    PipelineName = tostring(pipelineName_s),
    RunId = tostring(runId_g),
    Status = coalesce(tostring(status_s), tostring(ResultType)),
    StartTime = start_t,
    EndTime = end_t,
    LoadDate = tostring(Parameters_p_load_date_s),
    SourceSystem = tostring(Parameters_p_source_system_s)
| project
    TimeGenerated,
    PipelineName,
    RunId,
    Status,
    StartTime,
    EndTime,
    DurationSeconds = datetime_diff("second", EndTime, StartTime),
    LoadDate,
    SourceSystem,
    Category
| order by TimeGenerated desc
