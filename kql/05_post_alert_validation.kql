// Phase 8 — 05 Post-alert validation
// Purpose: After creating an alert rule, verify the failure condition still evaluates.

AzureDiagnostics
| where TimeGenerated > ago(1h)
| where ResourceProvider == "MICROSOFT.DATAFACTORY"
| where Category in ("PipelineRuns", "ActivityRuns")
| where pipelineName_s == "pl_ingest_retail_files_prdp"
| extend Status = tostring(status_s)
| summarize
    TotalRecords = count(),
    FailedRecords = countif(Status !in ("Succeeded", "InProgress", "Queued", "Started") or isnotempty(Error_message_s) or isnotempty(Error_errorCode_s)),
    LastRecord = max(TimeGenerated)
